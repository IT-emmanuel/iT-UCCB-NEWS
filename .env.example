# Copiez ce fichier en .env puis remplissez les valeurs. Le fichier .env n'est jamais envoyé sur GitHub.
# Utilisez uniquement des lettres et des chiffres dans les mots de passe (pas de @ : / # ?).

# Signature des sessions : openssl rand -hex 32
SECRET_KEY=remplacez-par-une-longue-valeur-aleatoire

# Base de données PostgreSQL (conteneur "db")
POSTGRES_DB=itnews
POSTGRES_USER=itnews
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe
